# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Claude / Anthropic 兼容接口（可选）=====
# 如果使用 Claude 兼容端点，设置 LLM_API_STYLE=anthropic
# 并填写下面三项；代码会自动兼容 v1/messages 协议
# 例如 Kimi Code:
# LLM_API_STYLE=anthropic
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding
# ANTHROPIC_API_KEY=your_kimi_code_api_key
# ANTHROPIC_MODEL=kimi-for-coding
# LLM_TRUST_ENV=false

# ===== Graphiti 记忆图谱配置 =====
# Graphiti 服务地址（例如本地部署）
GRAPHITI_API_KEY=your_graphiti_api_key_here
GRAPHITI_BASE_URL=http://localhost:8000
GRAPHITI_TRUST_ENV=false
GRAPHITI_TIMEOUT_SECONDS=60
# 可选：是否启用 Thread API 兼容层
GRAPHITI_THREAD_API_ENABLED=true

# 如果使用仓库内的 local_graphiti 本地兼容服务，可参考：
# docs/local-graphiti-neo4j.md
# 典型配置：
# GRAPHITI_API_KEY=local-graphiti
# GRAPHITI_BASE_URL=http://127.0.0.1:8000

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
